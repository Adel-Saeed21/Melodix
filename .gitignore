app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
# Firebase Configuration
lib/firebase_options.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
# OpenSubtitles API key (copy config/opensubtitles.example.json). Ignoring it
# only keeps it out of git: the key is still compiled into the app.
/config/opensubtitles.json

# Release debug symbols (kept to read obfuscated crash reports)
/release-symbols/
