    <item name="ic_launcher_red" type="mipmap">@mipmap/ic_launcher</item>
    <item name="ic_launcher_orange" type="mipmap">@mipmap/ic_launcher</item>
    <item name="ic_launcher_yellow" type="mipmap">@mipmap/ic_launcher</item>
    <item name="ic_launcher_teal" type="mipmap">@mipmap/ic_launcher</item>
    <item name="ic_launcher_green" type="mipmap">@mipmap/ic_launcher</item>
    <color name="ic_launcher_background">#FF0D0C0C</color>
</resources>
